rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   match /users/{uid} {
     allow read, create, update: if request.auth != null && request.auth.uid == uid;
     allow delete: if false;
     match /sermons/{sermonId} { allow read, write: if request.auth != null && request.auth.uid == uid; }
     match /private/{docId} { allow read, write: if request.auth != null && request.auth.uid == uid; }
   }
   match /{document=**} { allow read, write: if false; }
 }
}
